# SkillProof Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in real values for local development.
# NEVER commit .env to git — it is in .gitignore.
#
# For production, set these in the Render dashboard under:
#   Dashboard → skillproof-api → Environment

# ── GitHub ───────────────────────────────────────────────────────────────────
# Personal Access Token with scopes: public_repo, read:user
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=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

# ── Google Gemini LLM ────────────────────────────────────────────────────────
# Generate at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=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

# Verify the free-tier model name is still current before deploying:
# https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Set to true during development to skip LLM calls and use mock responses.
# Always false in production.
USE_LLM_MOCK=false

# ── Database ─────────────────────────────────────────────────────────────────
# Supabase PostgreSQL connection string.
# Find at: Supabase dashboard → Project Settings → Database → Connection string (URI)
# Use the "Session mode" URI (port 5432), NOT the transaction pooler (port 6543).
DATABASE_URL=ppostgresql://postgres.xtzllpbnljoggismljow:?dm_PPyL.wb$p3c@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# Generate both with: python -c "import secrets; print(secrets.token_hex(32))"
# Use different values for each secret.
JWT_SECRET=28fc892c9b319f3902ebda9b304da7e700203edffc1843095ef3e2b5ebf478fc
JWT_REFRESH_SECRET=9d5fcca67f7746e1d1fd7a4744ec01f25dff73945cbd2b5178f7e1f4c526a9c8

# ── Scheduler ────────────────────────────────────────────────────────────────
# Shared secret between the GitHub Actions cron and the backend endpoint.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Also set as a GitHub Actions repo secret named SCHEDULER_SECRET.
SCHEDULER_SECRET=68f3833214e31bf62611cc83170ed0de8c768f237ec6b0f44baad98cce0ba13d

# ── CORS ─────────────────────────────────────────────────────────────────────
# Development: http://localhost:3000
# Production:  your exact Vercel deployment URL (no trailing slash).
#              Multiple origins: https://skillproof.vercel.app,https://www.skillproof.app
CORS_ORIGINS=http://localhost:3000
